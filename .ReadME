EigenX
- dual feature(friend invite,random search) based on skills
- dashboard(ranking based on time constraint,level)
- mental math(3 level)
- profile with online/offline feature 



calculations

UPDATE calculations
SET
    difficulty_level = v.difficulty_level,
    left_min_digits = v.left_min_digits,
    left_max_digits = v.left_max_digits,
    right_min_digits = v.right_min_digits,
    right_max_digits = v.right_max_digits,
    decimal_places = v.decimal_places
FROM (
    VALUES
        (1, 1, 2, 2, 2, 2, 0),
        (2, 1, 2, 2, 2, 2, 0),
        (3, 1, 2, 2, 1, 1, 0),
        (4, 1, 2, 2, 1, 1, 0),
        (5, 2, 3, 3, 3, 3, 0),
        (6, 2, 3, 3, 3, 3, 0),
        (7, 2, 2, 2, 2, 1, 0),
        (8, 2, 2, 2, 2, 2, 1),
        (9, 3, 4, 4, 4, 4, 0),
        (10, 3, 4, 4, 4, 4, 0),
        (11, 3, 3, 3, 2, 2, 0),
        (12, 3, 3, 3, 2, 2, 1)
) AS v(
    id,
    difficulty_level,
    left_min_digits,
    left_max_digits,
    right_min_digits,
    right_max_digits,
    decimal_places
)
WHERE calculations.id = v.id;